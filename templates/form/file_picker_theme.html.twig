{# FilePickerType widget, driven by the Stimulus `gm-file-picker` controller (files rendered from `files`). #}
{% block gm_file_picker_widget %}
    {% trans_default_domain 'GingermindsMediaManager' %}
    {% set labels = {} %}
    {% for key in ['choose', 'replace', 'add', 'remove', 'reorder', 'empty'] %}
        {% set labels = labels|merge({(key): ('file.picker.' ~ key)|trans}) %}
    {% endfor %}
    <div class="gm-file-picker{{ multiple ? ' is-multiple' }}" data-controller="gm-file-picker"
         data-gm-file-picker-url-value="{{ picker_url }}"
         data-gm-file-picker-multiple-value="{{ multiple ? 'true' : 'false' }}"
         data-gm-file-picker-accept-value="{{ accept|json_encode }}"
         data-gm-file-picker-start-path-value="{{ start_path }}"
         data-gm-file-picker-files-value="{{ files|json_encode }}"
         data-gm-file-picker-preview-url-value="{{ preview_url }}"
         data-gm-file-picker-id-placeholder-value="{{ id_placeholder }}"
         data-gm-file-picker-labels-value="{{ labels|json_encode }}">
        <input type="hidden" {{ block('widget_attributes') }} value="{{ value }}" data-gm-file-picker-target="input">
        <div class="gm-file-picker-items" data-gm-file-picker-target="items"></div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary" data-gm-file-picker-target="button" data-action="gm-file-picker#open"{{ can_pick and not disabled ? '' : ' disabled' }}>
                <i class="bi bi-folder2-open me-1"></i> <span data-gm-file-picker-target="buttonLabel">{{ (multiple ? 'file.picker.add' : 'file.picker.choose')|trans }}</span>
            </button>
            {% if accept is not empty %}
                <span class="form-text m-0">{{ 'file.picker.accept'|trans({'%types%': accept|join(', ')}) }}</span>
            {% endif %}
        </div>
        {% if not can_pick %}
            <div class="form-text text-danger">{{ 'file.picker.forbidden'|trans }}</div>
        {% endif %}
    </div>
{% endblock %}
