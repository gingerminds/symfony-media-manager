    import FileSelectionController from '{{ asset('gingerminds-media-manager/controllers/file_selection_controller.js') }}';
    import FileUploadController from '{{ asset('gingerminds-media-manager/controllers/file_upload_controller.js') }}';

    app.register('gm-file-dialog', FileDialogController);
    app.register('gm-file-filters', FileFiltersController);
    app.register('gm-file-selection', FileSelectionController);
