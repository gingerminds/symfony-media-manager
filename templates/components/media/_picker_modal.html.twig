{#
 # Media picker (MediaController::picker), loaded once per page by `gm-media-select` and shared by
 # the fields: `gm-pick` reloads its Turbo frame for each field (allowed categories, page size) and
 # keeps the picked medias across its navigations (search, category, pages).
 #}
{% trans_default_domain 'GingermindsMediaManager' %}
{% import '@GingermindsMediaManager/components/file/_macros.html.twig' as m %}
<div class="modal fade gm-media-picker-modal" id="gm-media-picker-modal" tabindex="-1" aria-labelledby="gm-media-picker-modal-title" aria-hidden="true"
     data-controller="gm-pick"
     data-gm-pick-none-value="{{ 'media_select.none'|trans }}"
     data-gm-pick-selected-value="{{ 'media_select.selected'|trans }}"
     data-action="turbo:frame-load->gm-pick#refresh">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-fullscreen-lg-down gm-media-picker-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="gm-media-picker-modal-title">{{ 'media_select.title'|trans }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'file.action.close'|trans }}"></button>
            </div>
            <div class="modal-body">
                <turbo-frame id="gm-media-picker" class="d-block">
                    {% include '@GingermindsCore/components/_flashes.html.twig' %}
                    <form method="get" action="{{ path('gingerminds_media_manager_media_picker') }}" class="row g-2 mb-3"
                          data-controller="gm-file-filters" data-action="change->gm-file-filters#submit">
                        {% for id in state.categories ?? [] %}<input type="hidden" name="categories[]" value="{{ id }}">{% endfor %}
                        <input type="hidden" name="per_page" value="{{ state.per_page }}">
                        <div class="col">
                            <input type="search" name="search" value="{{ state.search ?? '' }}" class="form-control" placeholder="{{ 'media_select.search'|trans }}"
                                   autocomplete="off" aria-label="{{ 'media_select.search'|trans }}" data-action="gm-file-filters#search">
                        </div>
                        {% if categories is not empty %}
                            <div class="col-md-4">
                                <select name="category" class="form-select" aria-label="{{ 'media.field.category'|trans }}">
                                    <option value="">{{ 'media_select.all_categories'|trans }}</option>
                                    {% for category in categories %}
                                        <option value="{{ category.id }}"{{ category.id == (state.category ?? null) ? ' selected' }}>{{ category.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                    </form>

                    <div class="gm-file-grid">
                        {% for media in medias %}
                            {% set item = items[media.id] %}
                            <div class="gm-file-card" data-media-id="{{ media.id }}" data-pick-id="{{ media.id }}">
                                <button type="button" class="gm-file-card-preview" title="{{ item.name }}"
                                        data-action="gm-pick#toggle" data-gm-pick-item-param="{{ item|json_encode }}">
                                    {% if item.thumbnailUrl %}
                                        <img src="{{ item.thumbnailUrl }}" alt="" loading="lazy">
                                    {% else %}
                                        <i class="bi {{ media.file ? m.icon(media.file) : 'bi-file-earmark' }}"></i>
                                    {% endif %}
                                </button>
                                <span class="gm-file-card-body">
                                    <span class="gm-file-card-name" title="{{ item.name }}">{{ item.name }}</span>
                                    <span class="small text-muted text-truncate">{{ item.category ?? item.code }}</span>
                                </span>
                            </div>
                        {% else %}
                            <div class="text-muted py-5 text-center gm-file-grid-message">{{ 'media_select.empty'|trans }}</div>
                        {% endfor %}
                    </div>

                    <div class="mt-3">
                        {% include '@GingermindsCore/components/list/_pagination.html.twig' with {items: medias, route: 'gingerminds_media_manager_media_picker'} only %}
                    </div>
                </turbo-frame>
            </div>
            <div class="modal-footer">
                <span class="text-muted small me-auto" data-gm-pick-target="summary"></span>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ 'file.action.cancel'|trans }}</button>
                <button type="button" class="btn btn-primary" disabled data-gm-pick-target="confirm" data-action="gm-pick#confirm">{{ 'media_select.select'|trans }}</button>
            </div>
        </div>
    </div>
</div>
