{% extends '@GingermindsCore/crud/list_tree.html.twig' %}
{% trans_default_domain 'GingermindsMediaManager' %}

{% block tree %}
    {% if roots is empty %}
        <div class="text-center text-muted py-5">
            <i class="bi bi-diagram-3 fs-1 d-block mb-2 opacity-25"></i>
            {{ 'media_category.message.no_items'|trans }}
        </div>
    {% else %}
        {% include '@GingermindsCore/components/list/_tree.html.twig' with {nodes: roots} %}
    {% endif %}
{% endblock %}
