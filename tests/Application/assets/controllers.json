{
    "controllers": {
        "@symfony/ux-autocomplete": {
            "autocomplete": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "tom-select/dist/css/tom-select.default.css": false,
                    "tom-select/dist/css/tom-select.bootstrap4.css": false,
                    "tom-select/dist/css/tom-select.bootstrap5.css": true
                }
            }
        },
        "@gingerminds/symfony-media-manager": {
            "file-dialog": {
                "enabled": true,
                "fetch": "lazy"
            },
            "file-filters": {
                "enabled": true,
                "fetch": "lazy"
            },
            "file-pick": {
                "enabled": true,
                "fetch": "lazy"
            },
            "file-picker": {
                "enabled": true,
                "fetch": "lazy"
            },
            "file-selection": {
                "enabled": true,
                "fetch": "lazy"
            },
            "file-upload": {
                "enabled": true,
                "fetch": "lazy"
            },
            "media-picker": {
                "enabled": true,
                "fetch": "lazy"
            },
            "media-select": {
                "enabled": true,
                "fetch": "lazy"
            }
        }
    },
    "entrypoints": []
}
